# Copy to .env (project root) and fill in. Never commit .env.
# Loaded automatically by `npm run dev` and `npm start`.

PORT=3210
# 127.0.0.1 = only this computer. Docker sets 0.0.0.0.
HOST=127.0.0.1
# Only behind a reverse proxy (Caddy): true, or the proxy IP(s). Unset or false = off.
# TRUST_PROXY=true

# Required: the server refuses to start without these two.
# Admin login password for /host and /screen (at least 12 characters). Changing it logs out
# every admin device. Best: generate it like SESSION_SECRET below (random, 16+ characters),
# because the server can't count guesses per device for every network. Avoid # and spaces,
# or wrap the password in double quotes.
ADMIN_PASSWORD=
# Signs the login and guest cookies (at least 32 random characters). Changing it logs everyone
# out, guests included. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional folders, relative to the project root.
# Game snapshots (git-ignored):
# DATA_DIR=data
# questions.json, guests.json, photos/:
# CONTENT_DIR=content

# Public demo: true = the example content in a fresh temp folder at every start (never the real
# files), a restart at 04:00 every night (with Docker's restart: unless-stopped that is the reset),
# demo players in the host panel, no photo uploads, and the password shown on the login page.
# DEMO_MODE=true

# The real event on the same address as the demo: logging in with EVENT_PASSWORD (12+ characters,
# never the demo password) restarts the server with the real content in EVENT_DIR (default: event/,
# with content/ and data/). Only one game runs at a time; "End the event" in the host panel goes back.
# EVENT_PASSWORD=
# EVENT_DIR=event
