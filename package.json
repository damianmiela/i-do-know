{
  "name": "idoknow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @idoknow/server\" \"npm run dev -w @idoknow/client\"",
    "build": "npm run build -w @idoknow/client && npm run build -w @idoknow/server",
    "start": "npm run start -w @idoknow/server",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test:e2e": "npm run build && playwright test -c tests/e2e",
    "test:load": "node tests/load/load.mjs",
    "texts:export": "node scripts/texts.mjs export",
    "texts:import": "node scripts/texts.mjs import"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
